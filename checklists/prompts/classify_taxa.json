{
  "text": {
    "format": {
      "type": "json_schema",
      "name": "taxon_extraction",
      "strict": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "taxon_rank": {
                  "type": "string",
                  "enum": [
                    "kingdom",
                    "phylum",
                    "class",
                    "order",
                    "genus",
                    "species",
                    "Unclear",
                    "Not applicable"
                  ]
                },
                "canonical_name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "taxon_rank",
                "canonical_name"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      }
    }
  }
}